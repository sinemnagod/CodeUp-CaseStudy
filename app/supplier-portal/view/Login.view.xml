<mvc:View
	controllerName="codeup.supplierportal.controller.Login"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	displayBlock="true">

	<!--
		The photo fills the page; the form floats on top of it in a Dialog.

		A Dialog is the only standard control that genuinely layers above the
		page - Page, FlexBox and Image have no z-ordering, so an overlay would
		otherwise need a CSS rule, and this project writes none.
		It has no header and cannot be dismissed: this is the page, not a popup.
	-->
	<Page showHeader="false" enableScrolling="false" backgroundDesign="List">

		<Image src="img/login.jpg"
			mode="Background"
			backgroundSize="cover"
			backgroundPosition="center center"
			backgroundRepeat="no-repeat"
			width="100%" height="100%"
			decorative="true"
			error=".onImageMissing"/>

		<dependents>
			<Dialog id="loginDialog"
				showHeader="false"
				contentWidth="26rem"
				escapeHandler=".onDialogEscape">
				<VBox class="sapUiMediumMargin">

				<Title text="{i18n>appTitle}" level="H1" titleStyle="H3"/>
				<Text text="{i18n>loginTitle}" class="sapUiTinyMarginTop sapUiMediumMarginBottom"/>

				<Label text="{i18n>emailLabel}" labelFor="email"/>
				<Input id="email"
				value="{ui>/email}"
				type="Email"
				placeholder="{i18n>emailPlaceholder}"
				submit=".onLogin"
				class="sapUiSmallMarginBottom"/>

				<Label text="{i18n>passwordLabel}" labelFor="password"/>
				<HBox alignItems="Center">
				<Input id="password"
				value="{ui>/password}"
				type="{ui>/passwordType}"
				submit=".onLogin">
				<layoutData><FlexItemData growFactor="1"/></layoutData>
				</Input>
				<!-- the eye icon that shows / hides the password -->
				<Button icon="{ui>/passwordIcon}" type="Transparent" press=".onTogglePassword"/>
				</HBox>

				<Button text="{i18n>loginButton}"
				type="Emphasized"
				icon="sap-icon://key"
				press=".onLogin"
				busy="{ui>/busy}"
				busyIndicatorDelay="0"
				class="sapUiMediumMarginTop"/>

				<Button text="{i18n>toRegisterLink}"
				type="Transparent"
				press=".onGoToRegister"
				class="sapUiTinyMarginTop"/>

				</VBox>
			</Dialog>
		</dependents>

	</Page>

</mvc:View>
