<mvc:View
	controllerName="codeup.supplierportal.controller.Login"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	displayBlock="true">

	<Page showHeader="false" backgroundDesign="List">
		<VBox height="100%" justifyContent="Center" alignItems="Center">
			<VBox width="24rem" class="sapUiLargeMargin">

				<Title text="{i18n>appTitle}" level="H1" titleStyle="H2"/>
				<Text text="{i18n>loginTitle}" class="sapUiSmallMarginTop sapUiMediumMarginBottom"/>

				<Label text="{i18n>emailLabel}" labelFor="email"/>
				<Input id="email"
					value="{ui>/email}"
					type="Email"
					placeholder="{i18n>emailPlaceholder}"
					submit=".onLogin"
					class="sapUiSmallMarginBottom"/>

				<Label text="{i18n>passwordLabel}" labelFor="password"/>
				<HBox alignItems="Center" class="sapUiSmallMarginBottom">
					<Input id="password"
						value="{ui>/password}"
						type="{ui>/passwordType}"
						submit=".onLogin">
						<layoutData><FlexItemData growFactor="1"/></layoutData>
					</Input>
					<!-- the eye icon that shows / hides the password -->
					<Button icon="{ui>/passwordIcon}" type="Transparent" press=".onTogglePassword"/>
				</HBox>

				<Button text="{i18n>loginButton}"
					type="Emphasized"
					icon="sap-icon://key"
					press=".onLogin"
					busy="{ui>/busy}"
					class="sapUiSmallMarginTop"/>

				<Button text="{i18n>toRegisterLink}"
					type="Transparent"
					press=".onGoToRegister"
					class="sapUiSmallMarginTop"/>

			</VBox>
		</VBox>
	</Page>

</mvc:View>
