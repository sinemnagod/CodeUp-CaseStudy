<mvc:View
	controllerName="codeup.supplierapprovals.controller.Main"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	displayBlock="true">

	<!--
		sap.f.DynamicPage is the standard Fiori "list report" frame: a title area
		that stays put, a header underneath that collapses as you scroll, and the
		content below. Nothing here is styled by us - the theme does all of it.
	-->
	<f:DynamicPage id="page" toggleHeaderOnTitleClick="true" fitContent="false">

		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{i18n>appTitle}" level="H1"/>
				</f:heading>
				<f:snappedContent>
					<Text text="{i18n>appDescription}"/>
				</f:snappedContent>
				<f:expandedContent>
					<Text text="{i18n>appDescription}"/>
				</f:expandedContent>
				<f:actions>
					<SearchField width="18rem"
						placeholder="{i18n>searchPlaceholder}"
						value="{ui>/searchQuery}"
						search=".onSearch"
						liveChange=".onSearch"/>
					<!-- only shown once some filter is actually active -->
					<Button text="{i18n>clearFiltersButton}"
						icon="sap-icon://clear-filter"
						visible="{ui>/hasFilters}"
						press=".onClearFilters"/>
					<Button icon="sap-icon://action-settings"
						tooltip="{i18n>settingsTooltip}"
						press=".onOpenSettings"/>
					<Button icon="sap-icon://refresh"
						tooltip="{i18n>refreshTooltip}"
						press=".onRefresh"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>

		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<!--
					SegmentedButton rather than IconTabBar/IconTabHeader: the icon
					tabs mark the active tab with a blue underline, which is drawn by
					the theme and cannot be turned off without custom CSS
					(showSelection="false" is deprecated and has no effect).
					A SegmentedButton shows the active choice as a pressed button
					instead - same behaviour, no underline, still a standard control.
				-->
				<SegmentedButton id="statusTabs"
					selectedKey="{ui>/statusFilter}"
					selectionChange=".onTabSelect"
					class="sapUiSmallMarginBottom">
					<items>
						<SegmentedButtonItem key="All"       icon="sap-icon://list"
							text="{ parts: ['i18n>tabAll', 'counts>/All'], formatter: '.formatTabText' }"/>
						<SegmentedButtonItem key="Submitted" icon="sap-icon://pending"
							text="{ parts: ['i18n>tabPending', 'counts>/Submitted'], formatter: '.formatTabText' }"/>
						<SegmentedButtonItem key="Approved"  icon="sap-icon://accept"
							text="{ parts: ['i18n>tabApproved', 'counts>/Approved'], formatter: '.formatTabText' }"/>
						<SegmentedButtonItem key="Rejected"  icon="sap-icon://decline"
							text="{ parts: ['i18n>tabRejected', 'counts>/Rejected'], formatter: '.formatTabText' }"/>
					</items>
				</SegmentedButton>
			</f:DynamicPageHeader>
		</f:header>

		<f:content>
			<Table id="applicationsTable"
				items="{ path: '/Applications',
				         parameters: { $count: true,
				                       $select: 'ID,companyName,contactPerson,email,phone,country,category,taxNumber,website,address,notes,submittedAt,status,certificateName,decisionNote,decidedBy,decidedAt,aiDecision' },
				         events: { dataReceived: '.onDataReceived' } }"
				growing="true" growingThreshold="20"
				mode="None"
				itemPress=".onRowPress"
				sticky="ColumnHeaders,HeaderToolbar"
				busyIndicatorDelay="0">

				<headerToolbar>
					<OverflowToolbar>
						<Title text="{i18n>tableTitle}" level="H2"/>
						<ObjectStatus text="{counts>/All}" state="Information" inverted="true"/>
						<ToolbarSpacer/>
					</OverflowToolbar>
				</headerToolbar>

				<!-- A proper Fiori empty state, with one of SAP's own illustrations. -->
				<noData>
					<IllustratedMessage
						illustrationType="sapIllus-NoEntries"
						title="{i18n>noDataTitle}"
						description="{i18n>noDataText}"/>
				</noData>

				<columns>
					<Column visible="{cols>/companyName}" width="16rem"><Text text="{i18n>colCompany}"/></Column>
					<Column visible="{cols>/contactPerson}" width="12rem"><Text text="{i18n>colContactPerson}"/></Column>
					<Column visible="{cols>/email}"><Text text="{i18n>colEmail}"/></Column>
					<Column visible="{cols>/phone}"><Text text="{i18n>colPhone}"/></Column>
					<Column visible="{cols>/country}" width="10rem"><Text text="{i18n>colCountry}"/></Column>
					<Column visible="{cols>/category}" width="10rem"><Text text="{i18n>colCategory}"/></Column>
					<Column visible="{cols>/taxNumber}"><Text text="{i18n>colTaxNumber}"/></Column>
					<Column visible="{cols>/website}"><Text text="{i18n>colWebsite}"/></Column>
					<Column visible="{cols>/address}"><Text text="{i18n>colAddress}"/></Column>
					<Column visible="{cols>/notes}"><Text text="{i18n>colNotes}"/></Column>
					<Column visible="{cols>/submittedAt}" width="13rem"><Text text="{i18n>colSubmittedAt}"/></Column>
					<Column visible="{cols>/status}" width="9rem" hAlign="End"><Text text="{i18n>colStatus}"/></Column>
				</columns>

				<items>
					<ColumnListItem type="Active">
						<cells>
							<ObjectIdentifier title="{companyName}"/>
							<Text text="{contactPerson}"/>
							<Text text="{email}"/>
							<Text text="{phone}"/>
							<Text text="{ path: 'country', formatter: '.formatCountry' }"/>
							<Text text="{ path: 'category', formatter: '.formatCategory' }"/>
							<Text text="{taxNumber}"/>
							<Text text="{website}"/>
							<Text text="{address}"/>
							<Text text="{notes}"/>
							<Text text="{ path: 'submittedAt', targetType: 'any', formatter: '.formatDateTime' }"/>
							<ObjectStatus
								text="{ path: 'status', formatter: '.formatStatusText' }"
								state="{ path: 'status', formatter: '.formatStatusState' }"
								inverted="true"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</f:content>

	</f:DynamicPage>

</mvc:View>
