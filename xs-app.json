{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/logged-out.html"
  },
  "routes": [
    {
      "source": "^/user-api(.*)$",
      "target": "$1",
      "service": "sap-approuter-userapi",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/portal/(.*)$",
      "target": "/portal/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/approval/(.*)$",
      "target": "/approval/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.Approval"
    },
    {
      "source": "^/supplier-portal/(.*)$",
      "target": "supplier-portal/$1",
      "localDir": "app",
      "authenticationType": "none"
    },
    {
      "source": "^/supplier-approvals/(.*)$",
      "target": "supplier-approvals/$1",
      "localDir": "app",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.Approval"
    },
    {
      "source": "^/logged-out.html$",
      "target": "logged-out.html",
      "localDir": "app",
      "authenticationType": "none"
    },
    {
      "source": "^/i18n/(.*)$",
      "target": "i18n/$1",
      "localDir": "app",
      "authenticationType": "none"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "app",
      "authenticationType": "xsuaa"
    }
  ]
}
