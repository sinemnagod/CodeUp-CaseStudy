{
  "_readme": [
    "Copy this file to 'default-env.json' (same folder) and paste your own",
    "XSUAA service key into the credentials block. default-env.json is in",
    ".gitignore because a service key is a secret - never commit it.",
    "The approuter reads this file automatically when it starts locally; on",
    "BTP the same values would arrive in the real VCAP_SERVICES variable."
  ],

  "destinations": [
    {
      "name": "srv-api",
      "url": "http://localhost:4004",
      "forwardAuthToken": true
    }
  ],

  "VCAP_SERVICES": {
    "xsuaa": [
      {
        "label": "xsuaa",
        "tags": [ "xsuaa" ],
        "name": "codeup-uaa",
        "instance_name": "codeup-uaa",
        "credentials": {
          "PASTE": "replace this whole credentials object with the one from your service key"
        }
      }
    ]
  }
}
