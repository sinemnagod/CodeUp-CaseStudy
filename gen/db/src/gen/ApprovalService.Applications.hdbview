VIEW ApprovalService_Applications AS SELECT
  Suppliers_0.ID,
  Suppliers_0.createdAt,
  Suppliers_0.createdBy,
  Suppliers_0.modifiedAt,
  Suppliers_0.modifiedBy,
  Suppliers_0.email,
  Suppliers_0.companyName,
  Suppliers_0.contactPerson,
  Suppliers_0.phone,
  Suppliers_0.country,
  Suppliers_0.category,
  Suppliers_0.taxNumber,
  Suppliers_0.website,
  Suppliers_0.address,
  Suppliers_0.notes,
  Suppliers_0.certificate,
  Suppliers_0.certificateMime,
  Suppliers_0.certificateName,
  Suppliers_0.certificateSize,
  Suppliers_0.status,
  Suppliers_0.submittedAt,
  Suppliers_0.decidedAt,
  Suppliers_0.decisionNote,
  Suppliers_0.decidedBy,
  Suppliers_0.aiDecision,
  Suppliers_0.editableFields
FROM codeup_supplier_Suppliers AS Suppliers_0
WHERE Suppliers_0.status <> 'New'