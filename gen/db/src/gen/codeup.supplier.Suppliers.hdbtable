COLUMN TABLE codeup_supplier_Suppliers (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  email NVARCHAR(200) NOT NULL,
  passwordHash NVARCHAR(200) NOT NULL,
  companyName NVARCHAR(100),
  contactPerson NVARCHAR(100),
  phone NVARCHAR(50),
  country NVARCHAR(100),
  category NVARCHAR(20),
  taxNumber NVARCHAR(50),
  website NVARCHAR(200),
  address NVARCHAR(500),
  notes NVARCHAR(1000),
  certificate BLOB,
  certificateMime NVARCHAR(100),
  certificateName NVARCHAR(255),
  certificateSize INTEGER,
  status NVARCHAR(20) DEFAULT 'New',
  submittedAt TIMESTAMP,
  decidedAt TIMESTAMP,
  decisionNote NVARCHAR(1000),
  decidedBy NVARCHAR(200),
  aiDecision BOOLEAN DEFAULT FALSE,
  editableFields NVARCHAR(500),
  PRIMARY KEY(ID)
)